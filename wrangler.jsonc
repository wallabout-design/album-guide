// Cloudflare Workers static assets. Workers Builds builds every push: main
// deploys to production, other branches upload a preview version with its own
// URL. The site keeps no data of its own (the catalog API is album-guide-api on
// Fly), so there is no separate preview Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "album-guide-site",
  // Runs only for /api/* (run_worker_first); everything else is static.
  // Routes: worker/index.ts.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // The app has one page, /. Any other path gets dist/404.html with HTTP 404
    // (docs/decisions/0010-real-404-and-root-base.md).
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  // Production. A Workers custom domain: the deploy creates the apex DNS record
  // and certificate. www.album.guide is a zone redirect rule, not a route, so
  // the Worker still runs only for /api/*. See docs/decisions/0003-domain.md.
  "routes": [{ "pattern": "album.guide", "custom_domain": true }],
  // workers.dev stays on because preview URLs live there.
  "workers_dev": true,
  // First-party telemetry (standards/telemetry.md). The account's shared
  // site_events dataset, keyed by site id "album-guide". Nothing is written
  // until the TELEMETRY_SALT secret is set (docs/open-items.md).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "site_events" }],
  "preview_urls": true,
  "observability": { "enabled": true },
}
