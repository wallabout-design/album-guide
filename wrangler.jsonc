// Cloudflare Workers static assets. Workers Builds builds every push: main
// deploys this Worker to production; every other branch uploads a version of
// the separate preview Worker (env.preview below), never of this one.
// See docs/decisions/0015-preview-worker.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "album-guide-site",
  // Runs first for every request (run_worker_first), so it can redirect
  // www.album.guide; it hands everything outside /api/* to ASSETS.
  // Routes: worker/index.ts.
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app has one page, /. Any other path gets dist/404.html with HTTP 404
    // (docs/decisions/0010-real-404-and-root-base.md).
    "not_found_handling": "404-page",
    // A path list can't match a hostname, so true rather than ["/api/*"]:
    // www requests have to reach the Worker (docs/decisions/0003-domain.md).
    "run_worker_first": true,
  },
  // Production. Workers custom domains: the deploy creates each DNS record and
  // certificate. www.album.guide only redirects (301) to album.guide, in
  // worker/index.ts, as rr does. See docs/decisions/0003-domain.md.
  "routes": [
    { "pattern": "album.guide", "custom_domain": true },
    { "pattern": "www.album.guide", "custom_domain": true },
  ],
  // Production answers on album.guide only. Previews live on the preview
  // Worker (env.preview), so no branch version of this Worker gets a URL.
  "workers_dev": false,
  "preview_urls": false,
  // First-party telemetry (standards/telemetry.md). The account's shared
  // site_events dataset, keyed by site id "album-guide". Nothing is written
  // until the TELEMETRY_SALT secret is set (docs/open-items.md).
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "site_events" }],
  "observability": { "enabled": true },
  // Staff-managed collections (src/lib/collections, src/collections.ts).
  // `npm run ship:production` applies migrations/ before each deploy.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "album-guide",
      "database_id": "5c602e10-7872-423d-9f53-95225326b3e4",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    // The preview Worker: every branch gets its URL here,
    // https://<branch>-album-guide-site-preview.jj-23b.workers.dev. It has no
    // routes and none of production's secrets, so a preview can't reach
    // anything production owns. Env config doesn't inherit bindings, so
    // everything is declared again. Uploaded with `--env preview`
    // (npm run ship:branch); docs/decisions/0015-preview-worker.md.
    "preview": {
      "name": "album-guide-site-preview",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      // Declared so /api/event behaves as in production. With no
      // TELEMETRY_SALT secret on this Worker, nothing is written.
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "site_events" }],
      // Its own database, shared by every branch preview: migrations/ plus
      // the fake picks in scripts/seed-preview.sql, both applied on upload.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "album-guide-preview",
          "database_id": "81d92323-3580-452a-9bc3-65f3977633cb",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
