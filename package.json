{
  "name": "album-guide",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/remove-source-maps.mjs",
    "build:production": "VITE_API_BASE=https://album-guide-api.fly.dev npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:preview": "PREVIEW_WORKER=1 npm run build:production",
    "deploy": "npm run build:production && npm run ship:production",
    "deploy:preview": "npm run build:preview && npm run ship:preview",
    "ship:production": "wrangler d1 migrations apply album-guide --remote && wrangler deploy",
    "ship:preview": "npm run db:preview && wrangler deploy --env preview",
    "ship:branch": "npm run db:preview && node scripts/upload-preview.mjs",
    "db:preview": "wrangler d1 migrations apply album-guide-preview --remote --env preview && wrangler d1 execute album-guide-preview --remote --env preview --yes --file scripts/seed-preview.sql",
    "e2e:server": "rm -rf .wrangler/e2e && wrangler d1 migrations apply album-guide-preview --local --env preview --persist-to .wrangler/e2e && wrangler d1 execute album-guide-preview --local --env preview --persist-to .wrangler/e2e --yes --file scripts/seed-preview.sql && wrangler dev --env preview --persist-to .wrangler/e2e --var TEST_COLLECTIONS:1 --ip 127.0.0.1",
    "cf-typegen": "wrangler types",
    "crawl": ".venv/bin/python -u scripts/crawl.py",
    "walk": "vite-node scripts/walk.ts --",
    "check": "npm run typecheck && npm run lint",
    "check:deploy": "wrangler deploy --dry-run --outdir .wrangler/dry-run && wrangler deploy --dry-run --env preview --outdir .wrangler/dry-run-preview",
    "render-check": "vite-node scripts/render-check.tsx",
    "crawl:deep": ".venv/bin/python -u scripts/crawl.py --pages 3 --sweeps 100",
    "export": ".venv/bin/python scripts/export_catalog.py",
    "db": "sqlite3 data/catalog.sqlite",
    "ingest-check": "vite-node scripts/ingest-check.ts --",
    "click-check": "vite-node scripts/click-check.tsx",
    "feedback-check": "vite-node scripts/feedback-check.tsx",
    "dist-check": "vite-node scripts/dist-check.ts",
    "api-wire-check": "vite-node scripts/api-wire-check.ts",
    "image-check": "bash api/image-check.sh",
    "dupe-check": ".venv/bin/python api/dupe-check.py",
    "engine-parity": "vite-node scripts/engine-parity.ts && .venv/bin/python api/parity-check.py",
    "engine-constants": "vite-node scripts/dump-lexicon.ts && .venv/bin/python scripts/export_engine_constants.py",
    "api": ".venv/bin/python api/server.py",
    "publish": "bash scripts/publish.sh",
    "ratings": ".venv/bin/python -u scripts/backfill_ratings.py",
    "backfill": ".venv/bin/python -u scripts/backfill_popularity.py",
    "eval": "vite-node scripts/eval-recs.ts --",
    "eval:fetch": ".venv/bin/python scripts/fetch_similar.py",
    "reach": "vite-node scripts/reach-check.ts",
    "typecheck": "tsc -b",
    "lint:html": "html-validate \"dist/**/*.html\"",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run render-check && npm run click-check && npm run feedback-check && npm run eval && npm run test:worker && npm run test:lib",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run build:production && npm run check:deploy && npm run lint:html && npm run dist-check && npm test",
    "screenshots": "SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "test:worker": "tsx --test worker/tests/*.test.ts",
    "test:lib": "tsx --test src/lib/**/tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/jost": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@sentry/core": "11.11.0",
    "@sentry/react": "11.11.0",
    "@wallabout-design/feedback": "github:wallabout-design/feedback#v0.3.0",
    "isbot": "5.2.2",
    "jose": "^6.2.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/workers-types": "^5.20261109.1",
    "@playwright/test": "^1.65.0",
    "@sentry/vite-plugin": "11.11.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "html-validate": "^11.21.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-node": "^6.0.0",
    "wrangler": "4.158.0"
  }
}
